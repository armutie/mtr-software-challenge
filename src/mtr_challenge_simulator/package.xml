<?xml version="1.0"?>
<package format="3">
  <name>mtr_challenge_simulator</name>
  <version>0.1.0</version>
  <description>Deterministic 2D simulator for the MTR software challenge.</description>
  <maintainer email="software@mtr.invalid">MTR Software Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

